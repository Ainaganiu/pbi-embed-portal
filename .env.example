# Server
PORT=3000

# Postgres connection string (used for admin settings, reports, and auth).
# Locally: use your Postgres instance's "External" connection URL.
# On Render: wire this via render.yaml's `fromDatabase`, not a literal value.
DATABASE_URL=

# Session cookie signing secret — any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Encrypts the Power BI client secret and LLM API key before they're stored
# in Postgres. Any string works (it's hashed internally) — e.g. `openssl rand -hex 32`.
SETTINGS_ENCRYPTION_KEY=

# Optional: set/reset the admin account from env instead of (or in addition
# to) the one-time UI bootstrap at /login.html. If both are set, they're
# applied on every boot — creating the admin if none exists, or overwriting
# the existing admin's username/password otherwise. This is the supported
# way to change the admin password (there's no change-password UI): edit
# these and restart/redeploy.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Everything else is configured at runtime via /admin, not env vars ---
# On first run (with ADMIN_USERNAME/ADMIN_PASSWORD unset), visit /login.html
# to create the admin account, then go to /admin.html to set: portal
# branding, Power BI service principal, the AI chat provider/API key, and
# the report registry (workspace/report/dataset IDs + the data-model
# description used to generate DAX for each report).
