# Server
PORT=3000

# Azure AD service principal (client credentials) used for app-owns-data embedding
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# One workspace/report/dataset ID per report registered in config/reports.js.
# The suffix (SAMPLE) must match the env var names referenced there.
PBI_WORKSPACE_ID_SAMPLE=
PBI_REPORT_ID_SAMPLE=
PBI_DATASET_ID_SAMPLE=

# --- Optional AI chat + chart panel ---
# Leave LLM_API_KEY blank to run as an embed-only portal (no chat panel at all).
# LLM_PROVIDER selects the adapter: anthropic | openai | deepseek | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides — each provider ships a sensible default model/base URL.
LLM_MODEL=
LLM_API_BASE=
